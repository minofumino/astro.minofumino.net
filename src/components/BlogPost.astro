---
import { formatDate } from '../lib/posts';

interface Props {
  title: string;
  url: string;
  pubDate: Date;
  description: string;
  tags?: string[];
}

const { title, url, pubDate, description, tags } = Astro.props;
const date = formatDate(pubDate);
---
<article class="article-card">
    <h3 class="article-card-title"><a href={url}>{title}</a></h3>
    <p><time datetime={date}>{date}</time></p>
    <p>{description}</p>
    {tags && tags.length > 0 && (
        <p class="tag">
            タグ:
            {tags.map((tag) => <a href={`/tags/${tag}`}>{tag}</a>)}
        </p>
    )}
</article>
