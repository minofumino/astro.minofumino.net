---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPost from '../../components/BlogPost.astro';
import { getPublishedPosts, getTagCounts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return getTagCounts(posts).map(({ tag }) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

interface Props {
  posts: Post[];
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---
<BaseLayout pageTitle={`Posts: ${tag}`}>
  <div class="article-list">
    <h2>「{tag}」のタグが付いた記事（{posts.length}件）</h2>
    {posts.map((post) => (
      <BlogPost url={`/posts/${post.slug}`}
        title={post.data.title}
        pubDate={post.data.pubDate}
        tags={post.data.tags}
        description={post.data.description} />
    ))}
  </div>
  <p>
    <a href="/posts" class="btn-flat-border">記事一覧へ</a>
    <a href="/tags" class="btn-flat-border">タグ一覧へ</a>
  </p>
</BaseLayout>
