---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTagCounts } from '../../lib/posts';

const tags = getTagCounts(await getPublishedPosts());
---
<BaseLayout pageTitle="Tags">
    <div class="article-list">
        <h2>タグ一覧</h2>
        <div class="tag">
            {tags.map(({ tag, count }) => <a href={`/tags/${tag}`}>{tag}（{count}）</a>)}
        </div>
    </div>

    <p>
        <a href="/posts" class="btn-flat-border">記事一覧</a>
    </p>
</BaseLayout>
