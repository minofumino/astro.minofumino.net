---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import BlogPost from '../components/BlogPost.astro';
import { getPublishedPosts } from '../lib/posts';

const pageTitle = "Home";
const description = "雑記スペース";

const recentPosts = (await getPublishedPosts()).slice(0, 3); // 最新3件

---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={"ふみ箱"} />
    <meta name="twitter:description" content={description}
    />
    <meta name="theme-color" content="#234059">
    <title>{"ふみ箱"}</title>
  </head>
  <body>
    <Header />
    
    <h1>{pageTitle}</h1>

    <div class="contents">
        <p>
            備忘録というか雑記スペースというか。ごみ箱じゃないよ。
        </p>
    </div>

    <div class="article-list">
        <h2>最近の記事</h2>
        {recentPosts.map((post) => (
          <BlogPost url={`/posts/${post.slug}`}
            title={post.data.title}
            pubDate={post.data.pubDate}
            description={post.data.description} />
        ))}
        <p><a href="/posts" class="btn-flat-border">記事一覧へ</a></p>
      </div>

    <Footer />
    <script>
      import "../scripts/menu.js";
    </script>
  </body>
</html>
