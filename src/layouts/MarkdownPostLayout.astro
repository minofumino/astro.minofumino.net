---
import BaseLayout from './BaseLayout.astro';
import { formatDate, type Post } from '../lib/posts';

interface Props {
  frontmatter: Post['data'];
}

const { frontmatter } = Astro.props;
const date = formatDate(frontmatter.pubDate);
---
<BaseLayout pageTitle={frontmatter.title} description={frontmatter.description} noindex={frontmatter.draft}>

    <div class="databox">
        <p class="article-pub-date"><time datetime={date}>{date}</time></p>
        <p class="tag">タグ:
        {frontmatter.tags.map((tag) => (
          <a href={`/tags/${tag}`}>{tag}</a>
        ))}
        </p>
    </div>
    <div class="contents">
        <slot />
    </div>
    <p>
        <a href="/posts" class="btn-flat-border">記事一覧へ</a>
        <a href="/tags" class="btn-flat-border">タグ一覧へ</a>
    </p>

</BaseLayout>
